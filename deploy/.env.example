SQLSERVER_HOST=host.docker.internal,1433
SQLSERVER_DB=ERP_DB
SQLSERVER_USER=erp_app
SQLSERVER_PASSWORD=change-me

POSTGRES_USER=admin
POSTGRES_PASSWORD=123456
