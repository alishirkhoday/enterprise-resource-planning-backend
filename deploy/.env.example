# (MongoCredential is commented out in ERP.WebApi/ConfigureServices.cs).


JWT_ISSUER=Domain
JWT_AUDIENCE=Domain.com
JWT_KEY=change-this-to-a-long-random-value-before-any-real-deployment

API_HTTP_PORT=8080
